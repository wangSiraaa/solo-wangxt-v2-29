{
  "name": "weave-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "浏览器内的经纬组织设计台：组织点阵、穿综、纹板与织物预览保持一致",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test:logic": "tsx scripts/check-logic.ts",
    "test:undo": "tsx scripts/check-undo.ts",
    "test:import": "tsx scripts/check-import.ts"
  },
  "dependencies": {
    "dexie": "^4.0.10",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
